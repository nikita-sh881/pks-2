      fx:controller="rentcar.controller.StatisticsController"
      spacing="6" padding="16">
    <Label text="Статистика" styleClass="title"/>
    <Label fx:id="totalClients"/>
    <Label fx:id="totalCars"/>
    <Label fx:id="totalRentals"/>
